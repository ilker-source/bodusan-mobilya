datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     String @default("admin")
}

model Category {
  id       String    @id @default(cuid())
  key      String    @unique
  titleTr  String
  titleEn  String
  slugTr   String    @unique
  slugEn   String    @unique
  order    Int       @default(0)
  parentId String?
  parent   Category?  @relation("AltKategori", fields:[parentId], references:[id])
  children Category[] @relation("AltKategori")
  products Product[]
}

model Product {
  id          String         @id @default(cuid())
  slugTr      String         @unique
  slugEn      String         @unique
  titleTr     String
  titleEn     String
  descTr      String
  descEn      String
  featured    Boolean        @default(false)
  active      Boolean        @default(true)
  order       Int            @default(0)
  olcuTr    String @default("")
  olcuEn    String @default("")
  renkTr    String @default("")
  renkEn    String @default("")
  malzemeTr String @default("")
  malzemeEn String @default("")
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  createdAt   DateTime       @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  isCover   Boolean @default(false)
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Slider {
  id       String  @id @default(cuid())
  titleTr  String
  titleEn  String
  imageUrl String
  link     String  @default("")
  order    Int     @default(0)
  active   Boolean @default(true)
}

model Page {
  id      String @id @default(cuid())
  slugTr  String @unique
  slugEn  String @unique
  titleTr String
  titleEn String
  bodyTr  String
  bodyEn  String
}

model Project {
  id      String  @id @default(cuid())
  titleTr String
  titleEn String
  descTr  String
  descEn  String
  imageUrl String @default("")
  active  Boolean @default(true)
}

model Post {
  id      String  @id @default(cuid())
  slugTr  String  @unique
  slugEn  String  @unique
  titleTr String
  titleEn String
  bodyTr  String
  bodyEn  String
  active  Boolean @default(true)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  type      String   @default("contact")
  name      String
  email     String
  phone     String   @default("")
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
